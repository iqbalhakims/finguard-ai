# Public entrypoint: HTTPS for Grafana only. Caddy obtains and renews the
# Let's Encrypt certificate for {$PUBLIC_HOST} by itself (HTTP-01 challenge on
# port 80) and stores it on the Terraform-managed volume mounted at /data.
{
	admin off
	servers {
		protocols h1 h2  # the DigitalOcean LB forwards TCP only, so no HTTP/3 (UDP)
	}
}

{$PUBLIC_HOST} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	reverse_proxy grafana.finguard.svc.cluster.local:3000
}
